# ==========================================
# Unreal Engine 5 .gitignore
# ==========================================

# Visual Studio / Rider / IDE temp files & solutions
.vs/
.idea/
.vscode/
*.sln
*.slnx
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.VC.db
*.opendb
*.opensdf
*.sdf
*.suo
*.user
*.userosv
*.sln.docstates
*.patch

# Xcode / CLion / JetBrains
*.xcodeproj
*.xcworkspace
.fleet/

# Unreal Engine build & intermediate artifacts
/Binaries/
/DerivedDataCache/
/Intermediate/
/Saved/
/Build/
/Packaged/

# Plugins intermediate & binaries (all levels)
Plugins/**/Binaries/
Plugins/**/Intermediate/
Plugins/**/DerivedDataCache/

# User-specific config
Config/User*.ini
Config/**/User*.ini

# Developer & personal collections in Content
Content/Developers/
Content/Collections/

# Marketplace / Fab asset packs (원본은 커밋하지 않음)
# 수정이 필요하면 원본을 건드리지 말고 복제본을 별도 폴더에 만들어 커밋한다.
Content/Hearthvale/
Content/__ExternalActors__/Hearthvale/
Content/__ExternalObjects__/Hearthvale/

# Crash reports and memory dumps
*.dmp
*.crashdump
*.log

# OS generated files
Thumbs.db
Desktop.ini
.DS_Store
